{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": false,
    "strict": false,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "types": [
      "node",
      "jest"
    ],
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "dist",
    "coverage",
    "node_modules"
  ]
}
